---
// A table of class starts. The rows come from classRows() in src/lib/site.ts; `scope` tells the
// browser which rows to show when it refreshes the table with the portal's classes
// (src/scripts/live-classes.ts).
import { ADMIN_ROWS, SCHED_SITE } from "../lib/site";
import { rowsHtml, type SchedScope, type ShownRow } from "../lib/live-classes";
const { rows, scope = {}, showCourse = true } = Astro.props as { rows: ShownRow[]; scope?: SchedScope; showCourse?: boolean };
const siteData = JSON.stringify({ site: SCHED_SITE, adminRows: ADMIN_ROWS }).replace(/</g, "\\u003c");
---
<div class="tbox" data-sched={JSON.stringify({ scope, showCourse })}><table>
  <thead><tr>{showCourse && <th>Class</th>}<th>Location</th><th>First class</th><th>Price</th><th><span class="sr">Book</span></th></tr></thead>
  <tbody set:html={rowsHtml(rows, showCourse, SCHED_SITE)} />
</table></div>
<script is:inline type="application/json" data-sched-site set:html={siteData}></script>
<script>import "../scripts/live-classes";</script>
<style>.sr{position:absolute;left:-9999px}</style>
