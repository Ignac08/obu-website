---
// Line icons from the approved design.
const { name, size = 26 } = Astro.props;
const P: Record<string, string> = {
  puppy: '<path d="M8 4 4 7v5l3 1M16 4l4 3v5l-3 1"/><path d="M7 13c0 4 2 7 5 7s5-3 5-7-2-7-5-7-5 3-5 7z"/><circle cx="10" cy="12" r=".6" fill="currentColor"/><circle cx="14" cy="12" r=".6" fill="currentColor"/><path d="M11 16h2"/>',
  leash: '<circle cx="6" cy="6" r="3"/><path d="M8 8c4 4 4 8 10 12"/><path d="M15 20h5v-5"/>',
  run: '<path d="M3 12h4l3-5 4 10 3-5h4"/>',
  home: '<path d="M3 11 12 4l9 7"/><path d="M5 10v10h14V10"/><path d="M10 20v-6h4v6"/>',
  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>',
  moon: '<path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/>',
  chat: '<path d="M4 5h16v11H9l-5 4z"/>',
  tree: '<path d="M12 3 6 11h3l-4 6h14l-4-6h3z"/><path d="M12 17v4"/>',
  badge: '<circle cx="12" cy="9" r="6"/><path d="M9 14l-2 7 5-3 5 3-2-7"/>',
  check: '<path d="M5 12l5 5 9-10"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
};
const sw = name === "check" ? 3 : name === "menu" ? 2.4 : 2;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={sw} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={P[name] ?? ""} />
