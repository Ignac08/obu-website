---
import { money, addressLine, locUrl, mapsUrl } from "../lib/site";
const { l } = Astro.props;
---
<div class="loc">
  <div class="top" style={`background:linear-gradient(180deg,rgba(0,0,0,0) 30%,rgba(0,0,0,.6)),url(/img/loc-${l.key}.jpg) center/cover;border-bottom:6px solid ${l.color}`}>{l.area}</div>
  <div class="body"><h3><a class="stretch" href={locUrl(l)}>{l.name}</a></h3><p class="muted" style="font-size:14px">{addressLine(l)}</p><p class="from">Daycare {money(l.daycare.one)} · Boarding {money(l.boarding.one)}</p>
    <div class="links"><span class="go">Visit location →</span><a class="dir" href={mapsUrl(l)} rel="noopener" aria-label={`Get directions to ${l.name}`}><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11 21 3l-8 18-2-8z"/></svg>Directions</a></div>
  </div>
</div>
