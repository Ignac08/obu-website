---
// Every page ends with this form. Netlify Forms receives it and emails the office (recipients are set in Netlify).
import { LOCATIONS, SITE, PHONE_HREF } from "../lib/site";
const {
  title = "How can we help?",
  sub = "Questions about daycare, boarding or training? Send us a note and one of our office staff will get back to you with answers and the best next step. No obligation.",
  loc = "",
  need = "",
} = Astro.props;
// Tick boxes, more than one allowed (owner, 2026-11-26). A page's `need` (e.g. "Puppy Class") pre-ticks
// its box and is also sent as "topic", so the office still sees the exact program asked about.
const interests = ["Daycare", "Boarding", "Training", "Board and Train", "Not sure"];
const TRAINING = ["Puppy Class", "Obedience Bootcamp", "Off Leash Freedom", "Behaviour consultation"];
const ticked = TRAINING.includes(need) ? "Training" : interests.includes(need) ? need : "";
const page = Astro.url.pathname;
---
<section class="band deep" id="lead"><div class="wrap split">
  <div class="stack">
    <p class="eyebrow" style="color:var(--sun)">Free advice, no pressure</p>
    <h2>{title}</h2>
    <p class="lead">{sub}</p>
    <div class="stack" style="gap:6px;margin-top:8px">
      <p class="muted">Prefer to talk now?</p>
      <a href={PHONE_HREF} style="font-family:var(--display);font-weight:800;font-size:32px;text-decoration:none;color:var(--deepInk)">{SITE.phone}</a>
      <p class="muted">{SITE.phoneHours}</p>
    </div>
  </div>
  <form class="formcard lead-form" name="contact" method="POST" action="/thank-you/" data-netlify="true" netlify-honeypot="bot-field">
    <input type="hidden" name="form-name" value="contact" />
    <input type="hidden" name="page" value={page} />
    <input type="hidden" name="subject" value="Website enquiry" />
    <p class="hp"><label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
    <div class="fgrid">
      <label>Your name<input name="name" required autocomplete="name" /></label>
      <label>Dog's name &amp; age<input name="dog" placeholder="e.g. Milo, 2 years" /></label>
      <label>Email<input name="email" type="email" autocomplete="email" /></label>
      <label>Phone<input name="phone" type="tel" autocomplete="tel" /></label>
      <label class="full">Closest location<select name="location"><option value="">Choose…</option>{LOCATIONS.map((l) => <option value={l.name} selected={loc === l.key}>{l.name}{l.key === "stavefalls" || l.key === "silverdale" ? " (Maple Ridge / Mission)" : ""}</option>)}</select></label>
      <input type="hidden" name="topic" value={need} />
      <fieldset class="full interests"><legend>What are you interested in? (tick all that apply)</legend>
        {interests.map((n) => <label class="tick"><input type="checkbox" name="interest[]" value={n} checked={n === ticked} />{n}</label>)}
      </fieldset>
      <label class="full">Tell us a bit more<textarea name="message" placeholder="Dates you need daycare or boarding, training goals, questions…"></textarea></label>
      <div class="full stack" style="gap:10px"><button class="btn primary" type="submit">Send to our office</button><p class="fmsg muted" style="font-size:14px" aria-live="polite">{SITE.replyPromise}</p></div>
    </div>
  </form>
</div></section>
<style>
  .interests{border:0;margin:0;padding:0;display:flex;flex-direction:column;gap:2px}
  .interests legend{font-weight:600;font-size:15px;margin-bottom:8px;padding:0}
  .interests .tick{display:inline-flex;flex-direction:row;align-items:center;gap:8px;font-weight:500;min-height:36px;cursor:pointer}
  .interests input{width:20px;height:20px;min-height:0;margin:0;accent-color:var(--cta)}
  .formcard .fmsg:not(.err){color:var(--muted)}
</style>
