---
import PageHead from "../components/PageHead.astro";
import Pic from "../components/Pic.astro";
import LeadForm from "../components/LeadForm.astro";
import { SITE, money, COURSES } from "../lib/site";
const { entry } = Astro.props;
const d = entry.data;
---
<PageHead crumbs={[["Training", "/training/"], ["Online courses"]]} eyebrow="Online courses" title={d.h1} lead={d.lead}>
  <div class="row" style="gap:12px;flex-wrap:wrap"><a class="btn primary" href="#courses">See the courses</a><a class="btn ghost" href={SITE.coursesUrl}>Already enrolled? Log in</a></div>
  <Pic slot="side" src="/img/g-class.jpg" alt="Handler practising obedience with a dog" eager />
</PageHead>
<section class="band" id="courses"><div class="wrap stack" style="gap:28px">
  <div class="stack" style="gap:10px"><h2>Choose a course</h2><p class="muted">{COURSES.intro}</p></div>
  <div class="grid g3">
    {COURSES.courses.map((c) => (
      <article class="tile course">
        {c.image && <img class="cimg" src={c.image} alt="" loading="lazy" width="600" height="400" />}
        <span class="tag">{c.tag}</span>
        <h3>{c.name}</h3>
        <p class="muted">{c.summary}</p>
        {c.points?.length > 0 && <ul class="cpts">{c.points.map((p) => <li>{p}</li>)}</ul>}
        <div class="cbuy"><span class="cprice">{money(c.price)}<small> CAD</small></span><a class="btn primary" href={c.url} rel="noopener">Buy now</a></div>
      </article>
    ))}
  </div>
  <p class="muted" style="font-size:14px">Courses are sold and watched on the Obedience Unleashed Portal. Buying takes you there to check out securely. Questions? Call {SITE.phone}.</p>
</div></section>
<section class="band sun"><div class="wrap stack" style="gap:24px">
  <h2>Want a trainer to watch you work?</h2>
  <p class="lead">Online courses are a great start. Pair them with a group class or a private consultation and we'll fine-tune things in person.</p>
  <div class="row" style="gap:12px;flex-wrap:wrap"><a class="btn primary" href="/training/">See in-person training</a><a class="btn ghost" href="/behavioural-consultation/">Book a consult</a></div>
</div></section>
<LeadForm />
